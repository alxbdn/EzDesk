<?xml version="1.0" encoding="utf-8"?>
<!-- Filled in by build-msix.ps1: {IDENTITY_NAME}, {PUBLISHER}, {PUBLISHER_DISPLAY_NAME}, {VERSION} -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{IDENTITY_NAME}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Desktop Switcher</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 = Windows 10 1809, the oldest build that gets the Windows 10 DLL path tested -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- DesktopSwitcher.exe is the AutoHotkey v2 runtime; it runs DesktopSwitcher.ahk next to it -->
    <Application Id="DesktopSwitcher" Executable="DesktopSwitcher.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Desktop Switcher"
        Description="Fast virtual-desktop switching for Windows, with a tray icon that shows which desktop you're on."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Start with Windows: active once the app has been launched, toggled in Settings > Apps > Startup -->
        <desktop:Extension Category="windows.startupTask" Executable="DesktopSwitcher.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DesktopSwitcherStartup" Enabled="true" DisplayName="Desktop Switcher" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for a classic desktop app: global hotkeys and the tray icon -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
